# lnurl-oidc-bridge — configuration (env vars only; never commit real secrets)

# HTTP server
PORT=3000
HOST=0.0.0.0

# OIDC issuer — the public base URL of this bridge, no trailing slash.
# All OIDC endpoints (authorize/token/jwks) are derived from it.
# Defaults to http://localhost:$PORT when unset (dev only).
OIDC_ISSUER=https://lnurl-oidc.example.com

# RS256 signing key, PEM (PKCS#8) used to sign issued ID tokens and exposed
# (public half only) at /jwks.json. Generate with:
#   openssl genpkey -algorithm RSA -pkcs8 -out signing.pem -pkeyopt rsa_keygen_bits:2048
# Paste the PEM here (newlines preserved). If unset, an ephemeral key is
# generated at startup — fine for local dev, NOT for production.
OIDC_PRIVATE_KEY=

# Optional explicit key id. Defaults to the RFC 7638 JWK thumbprint of the key.
OIDC_KEY_ID=
