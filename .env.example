# lnurl-oidc-bridge — configuration (env vars only; never commit real secrets)

# HTTP server
PORT=3000
HOST=0.0.0.0

# OIDC issuer — the public base URL of this bridge, no trailing slash.
# All OIDC endpoints (authorize/token/jwks) are derived from it.
# Defaults to http://localhost:$PORT when unset (dev only).
OIDC_ISSUER=https://lnurl-oidc.example.com

# RS256 signing key. Resolved in this order:
#   1. OIDC_PRIVATE_KEY       — inline PEM (PKCS#8), pasted below (newlines kept).
#   2. OIDC_PRIVATE_KEY_FILE  — a path on a mounted volume; loaded if present,
#                               otherwise generated and persisted (0600) on first
#                               boot. This is the recommended container setup.
#   3. neither                — ephemeral key (local dev only). In production
#                               (NODE_ENV=production) the bridge refuses to start.
# Generate an inline key with:
#   openssl genpkey -algorithm RSA -out signing.pem -pkeyopt rsa_keygen_bits:2048
OIDC_PRIVATE_KEY=
OIDC_PRIVATE_KEY_FILE=

# Optional explicit key id. Defaults to the RFC 7638 JWK thumbprint of the key.
OIDC_KEY_ID=

# Registered OIDC client (your Logto instance). The bridge currently supports
# one client. redirect_uris are exact-matched; separate multiple with spaces
# or commas. For Logto's standard OIDC connector the redirect URI looks like
#   https://<your-logto>/callback/<connector-id>
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URIS=
